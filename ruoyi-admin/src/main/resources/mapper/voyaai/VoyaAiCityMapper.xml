<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.voyaai.mapper.VoyaAiCityMapper">
    <resultMap id="CityResult" type="VoyaAiCity">
        <id property="id" column="id"/>
        <result property="provinceId" column="province_id"/>
        <result property="name" column="name"/>
        <result property="coverImage" column="cover_image"/>
        <result property="description" column="description"/>
        <result property="latitude" column="latitude"/>
        <result property="longitude" column="longitude"/>
        <result property="sort" column="sort"/>
        <result property="status" column="status"/>
        <result property="viewCount" column="view_count"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="delFlag" column="del_flag"/>
        <result property="remark" column="remark"/>
    </resultMap>
    <sql id="columns">select id,
                             province_id,
                             name,
                             cover_image,
                             description,
                             latitude,
                             longitude,
                             sort,
                             status,
                             view_count,
                             create_by,
                             create_time,
                             update_by,
                             update_time,
                             del_flag,
                             remark
                      from voya_ai_city</sql>
    <select id="selectVoyaAiCityById" resultMap="CityResult">
        <include refid="columns"/>
        where id=#{id} and del_flag='0'
    </select>
    <select id="selectVoyaAiCityList" parameterType="VoyaAiCity" resultMap="CityResult">
        <include refid="columns"/>
        <where>del_flag='0'
            <if test="provinceId != null">and province_id=#{provinceId}</if>
            <if test="name != null and name != ''">and name like concat('%',#{name},'%')</if>
            <if test="status != null and status != ''">and status=#{status}</if>
        </where>
        order by sort asc, id desc
    </select>
    <insert id="insertVoyaAiCity" parameterType="VoyaAiCity" useGeneratedKeys="true"
            keyProperty="id">insert into voya_ai_city (province_id, name, cover_image, description, latitude, longitude,
                                                       sort, status, create_by, create_time, del_flag, remark)
                             values (#{provinceId}, #{name}, #{coverImage}, #{description}, #{latitude}, #{longitude},
                                     coalesce(#{sort}, 0), coalesce(#{status}, '0'), #{createBy}, now(), '0',
                                     #{remark})</insert>
    <update id="updateVoyaAiCity" parameterType="VoyaAiCity">update voya_ai_city
                                                             set province_id=#{provinceId},
                                                                 name=#{name},
                                                                 cover_image=#{coverImage},
                                                                 description=#{description},
                                                                 latitude=#{latitude},
                                                                 longitude=#{longitude},
                                                                 sort=#{sort},
                                                                 update_by=#{updateBy},
                                                                 update_time=now(),
                                                                 remark=#{remark}
                                                             where id = #{id}
                                                               and del_flag = '0'</update>
    <update id="updateVoyaAiCityStatus" parameterType="VoyaAiCity">update voya_ai_city
                                                                   set status=#{status},
                                                                       update_by=#{updateBy},
                                                                       update_time=now()
                                                                   where id = #{id}
                                                                     and del_flag = '0'</update>
    <update id="deleteVoyaAiCityById">update voya_ai_city
                                      set del_flag='1',
                                          update_time=now()
                                      where id = #{id}
                                        and del_flag = '0'</update>
    <update id="deleteVoyaAiCityByIds">update voya_ai_city set del_flag='1',update_time=now() where id in <foreach
            item="id" collection="array" open="(" separator="," close=")">#{id}
    </foreach> and del_flag='0'
    </update>
</mapper>
